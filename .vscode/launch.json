{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}/tmp/corpora/discourse"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "build the extension",
      "env": {
        "YA_LSP_LOG": "ya_lsp=debug"
      }
    },
    {
      "name": "Multi-root gem check",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}/tmp/multiroot/ya-lsp-multiroot.code-workspace"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/dist/**/*.js"],
      "preLaunchTask": "build the extension (release)",
      "env": {
        "YA_LSP_LOG": "ya_lsp=debug"
      }
    }
  ]
}
